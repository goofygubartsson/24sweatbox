{
  "name": "atc24academy-sweatbox",
  "private": true,
  "description": "ATC24Academy Sweatbox: multi-user ATC radar training simulator for ATC24 / PTFS",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "data": "tsx scripts/build-data.ts",
    "sbx:convert": "tsx scripts/convert-sbx.ts",
    "predev": "tsx scripts/build-data.ts",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node scripts/pnpm.mjs --filter @sweatbox/server dev",
    "dev:web": "node scripts/pnpm.mjs --filter @sweatbox/web dev",
    "prebuild": "tsx scripts/build-data.ts",
    "build": "node scripts/pnpm.mjs -r --filter ./apps/* build",
    "start": "node scripts/pnpm.mjs --filter @sweatbox/server start",
    "serve": "node scripts/serve.mjs",
    "autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/autostart.ps1",
    "academy": "node scripts/pnpm.mjs --silent --filter @sweatbox/server academy",
    "pretypecheck": "tsx scripts/build-data.ts",
    "typecheck": "node scripts/pnpm.mjs -r typecheck",
    "pretest": "tsx scripts/build-data.ts",
    "test": "node scripts/pnpm.mjs -r test",
    "e2e": "playwright test",
    "check": "node scripts/pnpm.mjs typecheck && node scripts/pnpm.mjs test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^3.24.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
