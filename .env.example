# ATC24Academy Sweatbox: secrets and per-machine overrides ONLY.
# Everything else lives in sweatbox.config.ts. Copy this file to .env and fill it in.
# Never commit real values: .env is git-ignored, this file is not.

# Discord OAuth2 application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: a bot in the ATC24Academy guild, used for periodic role re-checks and to DM hosts their
# ATC24Academy bookings
DISCORD_BOT_TOKEN=
# Must exactly match a redirect registered on the Discord application
DISCORD_REDIRECT_URI=https://sb.atc24academy.com/auth/callback

# Random 64 bytes (e.g. `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`).
# Signs the OAuth state and encrypts stored Discord tokens and academy launch links.
SESSION_SIGNING_SECRET=

# Optional override of config.app.port
PORT=

# production | development. Development enables the dev-login bypass below.
NODE_ENV=production

# Development only: skip Discord and log everyone in as a fake host or viewer.
# DEV_FAKE_USER=host

# ---- ATC24Academy integration (docs/academy-integration.md) ----
# `pnpm academy keys` generates the key, its hash and the webhook secret.
# The only origin allowed to receive results (callbackUrl); empty turns the integration off.
ACADEMY_BASE_URL=
# SHA-256 hex of the API key the academy sends (comma-separate two while rotating)
ACADEMY_API_KEY_HASH=
# Shared with the academy (its SWEATBOX_WEBHOOK_SECRET); signs result callbacks
ACADEMY_WEBHOOK_SECRET=
# Lifetime of one-time launch links, seconds (30-300)
ACADEMY_LAUNCH_TOKEN_TTL_SECONDS=300
