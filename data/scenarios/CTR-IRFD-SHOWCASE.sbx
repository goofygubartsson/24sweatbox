# ATC24Academy Sweatbox showcase: Rockford CTR, TWR and GND at once, about 45 minutes.
#
# Every departure, arrival and through flight files a route of published fixes and flies it.
# Nothing is automatic: the aircraft do what the file and the controllers tell them.
# Load it on the scope with SBLOAD CTR-IRFD-SHOWCASE. Everyone starts on the radar view; LDARPT IRFD
# TWR or LDARPT IRFD GND switches your own scope to the tower or ground view, and Session > TWR
# makes Rockford arrivals need a landing clearance.

[sweatbox]
name = CTR-IRFD-SHOWCASE
airport = IRFD
view = CTR
departure runway = 25L
arrival runways = 25C, 25R
after landing = stand

[00:00] message: text="Rockford showcase: CTR, TWR and GND traffic, departures off 25L, arrivals to 25C and 25R, circuits at Mellor."

