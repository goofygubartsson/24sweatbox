# Sample scenario written for development. It is NOT one of the 18 legacy scenarios.
#
# Rockford tower, 20 minutes: every stand starts occupied and the aircraft push and taxi to the
# 25L holding point by themselves, one after another (two of them GA circuit flights). Clear them
# for takeoff; departures fly their route and land at their destination. Arrivals on final for 25C
# and 25R need a landing clearance, then cross 25L to a stand.

[sweatbox]
name = TWR-IRFD-DEMO
airport = IRFD
view = TWR
departure runway = 25L
arrival runways = 25C, 25R
after landing = stand

[00:00] message: text="Rockford tower demo: departures hold short of 25L, arrivals need LAND or they go around."
